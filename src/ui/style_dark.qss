/* Globale Schriftart und Basis */
* {
    font-family: 'Segoe UI', Inter, sans-serif;
    color: #e0e0e0;
}

QToolTip {
    background-color: #18181b;
    color: #f4f4f5;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10pt;
}

/* Hauptfenster (Main Canvas) */
QMainWindow {
    background-color: #2a2a2a;
}

/* ScrollAreas entfernen störende Rahmen */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------------------------------
   SEITENLEISTE (Sidebar)
--------------------------------- */
#SidebarFrame {
    background-color: #121212;
    border-right: 1px solid #333333;
}

#SidebarTitle {
    color: #e0e0e0;
    font-size: 16pt;
    font-weight: bold;
}

#SidebarSectionLabel {
    color: #a0a0a0;
    font-size: 10pt;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 15px;
    margin-bottom: 5px;
}

/* Standard Seitenleisten Button */
#SidebarBtn {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 11pt;
    font-weight: 500;
}

#SidebarBtn:hover {
    background-color: #2a2a2a;
    color: #3a7ebf;
}

/* Der aktuell ausgewählte Button (Active State) */
#SidebarBtn[active="true"] {
    background-color: #2c3e50;
    color: #3a7ebf;
    font-weight: bold;
}

#SettingsBtn {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 10px 15px;
    text-align: left;
    font-size: 11pt;
    font-weight: bold;
}
#SettingsBtn:hover {
    background-color: #2a2a2a;
}

/* Kunden-Liste Container */
#ClientItem {
    background-color: transparent;
    border-radius: 6px;
}
#ClientItem:hover {
    background-color: #2a2a2a;
}
#ClientItem[active="true"] {
    background-color: transparent;
}

/* Kunden-Liste Name */
#ClientName {
    color: #e0e0e0;
    font-size: 10pt;
}
#ClientName[active="true"] {
    color: #3a7ebf;
    font-weight: bold;
}

/* Suchen Input & SpinBox */
QLineEdit, QSpinBox {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10pt;
    color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #3a7ebf;
}

/* Action Buttons (z.B. +, Kunde bearbeiten) */
#ActionBtn {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 6px 10px;
}
#ActionBtn:hover {
    background-color: #2a2a2a;
    border: 1px solid #cdd5df;
}

/* ---------------------------------
   DASHBOARD KARTEN
--------------------------------- */
#DashboardTitle {
    font-size: 24pt;
    font-weight: bold;
    color: #e0e0e0;
}

/* Der Body der Karte (Weißer Hintergrund) */
#CardBody {
    background-color: #1e1e1e;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* Der Header der Karte (Blau) */
#CardHeaderBlue {
    background-color: #3a7ebf;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* Der Header der Karte (Grün) */
#CardHeaderGreen {
    background-color: #2e9e63;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#CardTitle {
    color: #1e1e1e;
    font-size: 12pt;
    font-weight: bold;
}

/* Tool Buttons auf den Werkzeug-Seiten */
#ToolBtn {
    background-color: #3a7ebf;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 11pt;
}
#ToolBtn:hover {
    background-color: #326ba3;
}

#ToolBtnSecondary {
    background-color: #2c3e50;
    color: #3a7ebf;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 11pt;
}
#ToolBtnSecondary:hover {
    background-color: #d1e5f7;
}

QTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 10px;
}

#SettingsFrame {
    border-radius: 10px;
    background-color: #1e1e1e;
    border: 1px solid #333333;
}

/* ---------------------------------
   DIALOGE & POPUPS
--------------------------------- */
QDialog {
    background-color: #18181b;
    color: #f1f5f9;
}

QDialog QLabel {
    color: #f1f5f9;
}

/* ---------------------------------
   BUTTONS (Standard & Primary)
--------------------------------- */
QPushButton {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 7px 15px;
    color: #f1f5f9;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #3f3f46;
    border-color: #52525b;
}
QPushButton:pressed {
    background-color: #52525b;
}

#PrimaryBtn, QPushButton#PrimaryBtn, QPushButton#BtnSaveDialog {
    background-color: #3a7ebf;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 11pt;
}
#PrimaryBtn:hover, QPushButton#PrimaryBtn:hover, QPushButton#BtnSaveDialog:hover {
    background-color: #4f96dc;
}
#PrimaryBtn:pressed, QPushButton#PrimaryBtn:pressed, QPushButton#BtnSaveDialog:pressed {
    background-color: #265584;
}

/* ---------------------------------
   REITER / TABS (QTabWidget & QTabBar)
--------------------------------- */
QTabWidget::pane {
    border: 1px solid #27272a;
    background-color: #1f1f23;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #27272a;
    color: #a1a1aa;
    padding: 8px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #27272a;
    border-bottom: none;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #1f1f23;
    color: #38bdf8;
    font-weight: bold;
    border-bottom: 2px solid #38bdf8;
}

QTabBar::tab:hover:!selected {
    background-color: #3f3f46;
    color: #ffffff;
}

/* ---------------------------------
   TABELLEN (QTableView z.B. KI-Training)
--------------------------------- */
QTableView {
    background-color: #18181b;
    alternate-background-color: #1f1f23;
    gridline-color: #27272a;
    color: #f1f5f9;
    border: 1px solid #27272a;
    border-radius: 8px;
    selection-background-color: #2c3e50;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item {
    padding: 6px;
    color: #f1f5f9;
    border-bottom: 1px solid #27272a;
}

QTableView::item:selected {
    background-color: #2c3e50;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #27272a;
    color: #d4d4d8;
    font-weight: bold;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid #3f3f46;
    border-right: 1px solid #3f3f46;
}

QHeaderView::section:horizontal {
    border-top: none;
}

QTableCornerButton::section {
    background-color: #27272a;
    border: none;
    border-bottom: 2px solid #3f3f46;
}

/* ---------------------------------
   DROPDOWNS (QComboBox)
--------------------------------- */
QComboBox {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 6px;
    padding: 6px 10px;
    color: #f1f5f9;
    font-size: 10pt;
}
QComboBox:hover {
    border-color: #52525b;
}
QComboBox:focus {
    border-color: #38bdf8;
}
QComboBox QAbstractItemView {
    background-color: #27272a;
    color: #f1f5f9;
    border: 1px solid #3f3f46;
    selection-background-color: #3f3f46;
    selection-color: #38bdf8;
    padding: 4px;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* ---------------------------------
   SCROLLBARS
--------------------------------- */
QScrollBar:vertical {
    border: none;
    background-color: #18181b;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #3f3f46;
    min-height: 25px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background-color: #52525b;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    border: none;
    background-color: #18181b;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background-color: #3f3f46;
    min-width: 25px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #52525b;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------
   DROPZONE (Drag & Drop Bereich)
--------------------------------- */
#DropZone {
    background-color: #1f1f23;
    border: 2px dashed #3f3f46;
    border-radius: 15px;
}
#DropZone[dragActive="true"] {
    background-color: #1e3a5f;
    border: 2px dashed #38bdf8;
}
#DropZone QLabel {
    color: #cbd5e1;
}

/* ---------------------------------
   KI-TRAINING CONTROL CARD
--------------------------------- */
#ControlsCard {
    background-color: #1f1f23;
    border-radius: 12px;
    border: 1px solid #27272a;
}

/* ---------------------------------
   CHECKBOXEN (QCheckBox)
--------------------------------- */
QCheckBox {
    color: #f1f5f9;
    font-size: 10pt;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #52525b;
    background-color: #27272a;
}
QCheckBox::indicator:hover {
    border-color: #38bdf8;
}
QCheckBox::indicator:checked {
    background-color: #3a7ebf;
    border-color: #3a7ebf;
    image: url("{{ASSETS_DIR}}/check_white.svg");
}
